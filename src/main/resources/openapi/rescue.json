  "components": {
    "schemas": {
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "description": "Canonical lowercase UUID with hyphens."
      },
      "Name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Unicode text trimmed at ends, not blank."
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "ISO-8601 UTC timestamp."
      },
      "MissionStatus": {
        "type": "string",
        "enum": [
          "ASSIGNED",
          "IN_PROGRESS",
          "COMPLETED"
        ],
        "description": "ASSIGNED -> IN_PROGRESS -> COMPLETED"
      },
      "RescueTeam": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "BUSY"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "availability"
        ],
        "description": "Availability is derived from active missions, not independently writable.",
        "example": {
          "id": "00000000-0000-4000-8000-000000000006",
          "name": "Demo team 1",
          "availability": "AVAILABLE"
        }
      },
      "RescueTeamPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RescueTeam"
            },
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "CreateMissionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reportId": {
            "$ref": "#/components/schemas/Id"
          },
          "teamId": {
            "$ref": "#/components/schemas/Id"
          }
        },
        "required": [
          "reportId",
          "teamId"
        ],
        "example": {
          "reportId": "00000000-0000-4000-8000-000000000005",
          "teamId": "00000000-0000-4000-8000-000000000006"
        }
      },
      "UpdateMissionStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ASSIGNED",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "status"
        ],
        "example": {
          "status": "IN_PROGRESS"
        }
      },
      "Mission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "reportId": {
            "$ref": "#/components/schemas/Id"
          },
          "teamId": {
            "$ref": "#/components/schemas/Id"
          },
          "status": {
            "$ref": "#/components/schemas/MissionStatus"
          },
          "assignedAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "startedAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "completedAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "id",
          "reportId",
          "teamId",
          "status",
          "assignedAt",
          "updatedAt"
        ],
        "description": "ASSIGNED: startedAt/completedAt absent. IN_PROGRESS: startedAt required, completedAt absent. COMPLETED: startedAt and completedAt required."
      },
      "MissionPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mission"
            },
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "timestamp",
          "status",
          "code",
          "message",
          "path",
          "fieldErrors"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
